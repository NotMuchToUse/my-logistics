# ==============================================================================
# 1. DEPENDENCIES (BẮT BUỘC CHẶN - CHẶN MỌI TẦNG THƯ MỤC)
# ==============================================================================
# Node.js dependencies (Web Khách, Web Nội bộ, Mobile)
node_modules/
**/node_modules/
web-customer/node_modules/
web-internal/node_modules/
mobile-driver/node_modules/

# PHP Composer dependencies (Server API)
vendor/
**/vendor/
server-php/vendor/
composer.phar

# ==============================================================================
# 2. FILE MÔI TRƯỜNG & MẬT KHẨU (BẢO MẬT - TUYỆT ĐỐI KHÔNG PUSH)
# ==============================================================================
# Chặn toàn bộ file .env chứa pass database, secret key, api key
.env
.env.*
*.env
server-php/.env
web-customer/.env
web-internal/.env
mobile-driver/.env

# Ngoại lệ: Cho phép push file mẫu (.env.example) để đồng đội biết cấu hình
!.env.example
!server-php/.env.example
!web-customer/.env.example
!web-internal/.env.example
!mobile-driver/.env.example

# File tài liệu nhạy cảm nội bộ test / backup dump
docs/SEED_CREDENTIALS.md
*.sql.gz
*.dump

# ==============================================================================
# 3. BUILD OUTPUTS & CACHE (FRONTEND & MOBILE)
# ==============================================================================
# Vite / React build outputs
dist/
**/dist/
build/
**/build/
out/
.vite/
**/.vite/
.next/
coverage/

# Expo / React Native / Mobile outputs (Đặt chờ cho mobile-driver)
.expo/
.expo-shared/
**/android/app/build/
**/android/.gradle/
**/ios/Pods/
**/ios/build/
.dart_tool/

# ==============================================================================
# 4. SERVER STORAGE, LOGS & CACHE (PHP SERVER)
# ==============================================================================
# Logs PHP và npm
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Thư mục lưu trữ tạm thời, file upload và log của Server PHP
server-php/storage/logs/*
!server-php/storage/logs/.gitkeep
server-php/storage/cache/*
!server-php/storage/cache/.gitkeep
server-php/storage/temp/*
!server-php/storage/temp/.gitkeep
server-php/storage/uploads/*
!server-php/storage/uploads/.gitkeep
server-php/storage/bills/*
!server-php/storage/bills/.gitkeep

# Unit test cache
.phpunit.result.cache

# ==============================================================================
# 5. OS & IDE ARTIFACTS (RÁC HỆ ĐIỀU HÀNH & TRÌNH SOẠN THẢO)
# ==============================================================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# VS Code / JetBrains / IDEs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json